import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix

DATA_PATH = '.'
df = pd.read_csv(f'{DATA_PATH}/student_performance.csv')

print("Dataset loaded successfully!")
print(df.head())
print("\nDataset shape:", df.shape)
print("\nDataset information:")
print(df.info())
print("\nStatistical summary:")
print(df.describe(include='all'))
print("\nMissing values:")
print(df.isnull().sum().sort_values(ascending=False))

df = df.drop_duplicates()
print("\nShape after removing duplicates:", df.shape)

numeric_columns = df.select_dtypes(include=['int64', 'float64']).columns

print("\nNumerical columns:")
print(numeric_columns)

df[numeric_columns].hist(figsize=(14, 10), bins=20)
plt.suptitle("Distribution of Numerical Variables")
plt.tight_layout()
plt.show()

plt.figure(figsize=(10, 7))
correlation = df[numeric_columns].corr()
sns.heatmap(correlation, annot=True, cmap='coolwarm', fmt='.2f')
plt.title("Correlation Matrix - Student Performance")
plt.show()

possible_marks = ['math_score', 'reading_score', 'writing_score', 'science_score']
available_marks = [c for c in possible_marks if c in df.columns]

if len(available_marks) > 0:
    plt.figure(figsize=(10, 6))
    df[available_marks].mean().plot(kind='bar')
    plt.title("Average Student Scores")
    plt.xlabel("Subject")
    plt.ylabel("Average Score")
    plt.xticks(rotation=45)
    plt.show()

if len(available_marks) > 0:
    df['average_score'] = df[available_marks].mean(axis=1)
    plt.figure(figsize=(8, 5))
    plt.hist(df['average_score'], bins=20)
    plt.title("Distribution of Average Student Scores")
    plt.xlabel("Average Score")
    plt.ylabel("Number of Students")
    plt.show()

attendance_column = None
for column in ['attendance', 'attendance_percentage', 'attendance_percent', 'Attendance']:
    if column in df.columns:
        attendance_column = column
        break

if attendance_column is not None and 'average_score' in df.columns:
    plt.figure(figsize=(8, 5))
    sns.scatterplot(data=df, x=attendance_column, y='average_score')
    plt.title("Attendance vs Student Performance")
    plt.xlabel("Attendance")
    plt.ylabel("Average Score")
    plt.show()

study_column = None
for column in ['study_hours', 'study_time', 'hours_studied', 'StudyHours']:
    if column in df.columns:
        study_column = column
        break

if study_column is not None and 'average_score' in df.columns:
    plt.figure(figsize=(8, 5))
    sns.scatterplot(data=df, x=study_column, y='average_score')
    plt.title("Study Hours vs Student Performance")
    plt.xlabel("Study Hours")
    plt.ylabel("Average Score")
    plt.show()

categorical_columns = df.select_dtypes(include=['object', 'category']).columns

print("\nCategorical columns:")
print(categorical_columns)

for column in categorical_columns[:5]:
    plt.figure(figsize=(8, 5))
    df[column].value_counts().head(10).plot(kind='bar')
    plt.title(f"Distribution of {column}")
    plt.xlabel(column)
    plt.ylabel("Number of Students")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

if 'average_score' not in df.columns:
    score_columns = [c for c in ['math_score', 'reading_score', 'writing_score', 'science_score'] if c in df.columns]
    if len(score_columns) > 0:
        df['average_score'] = df[score_columns].mean(axis=1)

if 'average_score' in df.columns:
    df['performance'] = (df['average_score'] >= 60).astype(int)
    print("\nPerformance distribution:")
    print(df['performance'].value_counts())

target = 'performance'
drop_columns = [target, 'average_score']
drop_columns = [c for c in drop_columns if c in df.columns]

X = df.drop(columns=drop_columns)
y = df[target]

X = pd.get_dummies(X, drop_first=True)
X = X.replace([float('inf'), float('-inf')], pd.NA)
X = X.apply(pd.to_numeric, errors='coerce')

imputer = SimpleImputer(strategy='median')
X = imputer.fit_transform(X)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

model = RandomForestClassifier(
    n_estimators=100,
    random_state=42
)

model.fit(X_train, y_train)
pred = model.predict(X_test)

accuracy = accuracy_score(y_test, pred)

print("\nModel Accuracy:", accuracy)
print("\nClassification Report:")
print(classification_report(y_test, pred))

cm = confusion_matrix(y_test, pred)

plt.figure(figsize=(6, 5))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
plt.title("Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.show()

encoded_columns = df.drop(columns=drop_columns)
encoded_columns = pd.get_dummies(encoded_columns, drop_first=True)

feature_names = encoded_columns.columns

importance = pd.DataFrame({
    'Feature': feature_names,
    'Importance': model.feature_importances_
})

importance = importance.sort_values(
    by='Importance',
    ascending=False
).head(15)

plt.figure(figsize=(10, 6))
sns.barplot(data=importance, x='Importance', y='Feature')
plt.title("Top Factors Affecting Student Performance")
plt.xlabel("Importance")
plt.ylabel("Feature")
plt.show()

if 'performance' in df.columns:
    performance_counts = df['performance'].value_counts()

    plt.figure(figsize=(7, 5))
    performance_counts.plot(kind='bar')
    plt.title("Student Performance Categories")
    plt.xlabel("Performance Category")
    plt.ylabel("Number of Students")
    plt.xticks([0, 1], ['Needs Improvement', 'Good Performance'], rotation=0)
    plt.show()

